{
  "expo": {
    "name": "Heron Capital",
    "slug": "heron-mobile",
    "scheme": "heron",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070908",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heron.mobile"
    },
    "android": {
      "package": "com.heron.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#181A20"
      }
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "light-content",
      "backgroundColor": "#181A20"
    },
    "web": {
      "bundler": "metro"
    }
  }
}